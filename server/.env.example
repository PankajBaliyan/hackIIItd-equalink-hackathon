# Copy to .env and fill in. Never commit .env or any private key.

# Where the dashboard runs (CORS + post-install redirect)
FRONTEND_URL=http://localhost:5173

# SQLite file for the connection and per-repo settings
DATABASE_URL=sqlite:///./equalink.db

# Secret used to sign the GitHub App install `state` value. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SECRET=

# Where this server is reachable (used to build the OAuth callback URL)
SERVER_URL=http://localhost:8000

# Scans may target localhost / private network addresses. Set false when deployed (SSRF protection).
ALLOW_PRIVATE_TARGETS=true
MAX_SITE_PAGES=5

# --- GitHub: choose ONE mode (priority: App > OAuth > token) -------------------

# Mode OAuth ("Sign in with GitHub" in the browser, recommended for dev):
# github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8000/integrations/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mode token (no browser login): personal access token. Needs `repo` scope (classic)
# or Contents + Pull requests read/write (fine-grained).
GITHUB_TOKEN=

# Mode App (production): GitHub App. Permissions: Contents (RW), Pull requests (RW), Metadata (R).
# Set the App's "Setup URL" to http://localhost:8000/integrations/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Either the PEM itself (use \n for newlines) or a path to the .pem file
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
