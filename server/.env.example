# Copy to .env and fill in. Never commit .env or any private key.

# Where the dashboard runs (CORS + post-install redirect)
FRONTEND_URL=http://localhost:5173

# PostgreSQL used by the GitHub connection, repositories, and sites modules.
# Put your local postgres password in server/.env, which is ignored by Git.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/equalink

# Secret used to sign OAuth state value (CSRF protection). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SECRET=

# Where this server is reachable (used to build the OAuth callback URL)
SERVER_URL=http://localhost:8000

# Scans may target localhost / private network addresses. Set false when deployed (SSRF protection).
ALLOW_PRIVATE_TARGETS=true
MAX_SITE_PAGES=20

# Starting values for scans and the AI switches. Everything in this block can also be changed in the dashboard
# (Settings), which saves it in the database and wins over what is written here; "Reset" returns to these.
# DEFAULT_LEVEL=AA
# DEFAULT_SCOPE=page
# MIN_SEVERITY=minor
# DISABLED_RULES=
# AI_REVIEW=true
# AI_FIXES=true

# --- GitHub: OAuth ("Sign in with GitHub") ------------------------------------
# github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8000/integrations/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Scan engine ---------------------------------------------------------------
# auto: render pages in a TinyFish remote browser (needs TINYFISH_API_KEY, public URLs only), else local Chromium.
# tinyfish: always TinyFish (scans fail if it is unavailable). local: always Chromium on this server.
# TinyFish browser sessions cost $0.002 per minute; each scan ends its session when it finishes.
SCAN_ENGINE=auto

# --- Repo (source code) scans -----------------------------------------------------
# Static checks always run. With a key, OpenAI also reviews the files against your saved W3C rules.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# SOURCE_MAX_FILES=150
# SOURCE_LLM_MAX_FILES=40

# --- Fixes module -------------------------------------------------------------
# Fixes and pull requests use DATABASE_URL above. Set FIXES_DATABASE_URL only
# when you deliberately want these two modules in a separate database.
FIXES_DATABASE_URL=
# Optional comma-separated origins in addition to FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Legacy PAT-only allowlist. The unified server normally uses the repositories
# enabled through the GitHub integration above.
GITHUB_REPOSITORIES=

# --- W3C rules sync (Docs > Reference documents) ---------------------------------
# A TinyFish agent fetches the latest W3C accessibility rules and adds only the ones not stored yet.
# The first run is always started with "Sync now"; after that it repeats every W3C_SYNC_INTERVAL_DAYS
# while the server is up. Each run uses TinyFish credits.
TINYFISH_API_KEY=
W3C_SYNC_SCHEDULE=true
W3C_SYNC_INTERVAL_DAYS=30
